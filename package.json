{
  "name": "dsh-usage-dashboard",
  "description": "Real-time usage dashboard for DSH: aggregates the harness's own per-session token/stat projections (tokenUsage, sessionStats) into a full-screen 用量统计 page. No external scrape, no login.",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-session-projection": "*",
    "@deepseek-ai/dsh-token-meter": "*",
    "@deepseek-ai/dsh-session-stats": "*",
    "@deepseek-ai/dsh-invariants": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-session-projection": { "optional": true },
    "@deepseek-ai/dsh-token-meter": { "optional": true },
    "@deepseek-ai/dsh-session-stats": { "optional": true },
    "@deepseek-ai/dsh-invariants": { "optional": true },
    "react": { "optional": true }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../dsh/vendor/cordis",
    "@deepseek-ai/dsh-client-runtime": "link:../dsh/packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-slots": "link:../dsh/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-settings": "link:../dsh/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-locale": "link:../dsh/packages/client/locale",
    "@deepseek-ai/dsh-client-web-react": "link:../dsh/packages/client/web-react",
    "@deepseek-ai/dsh-session-projection": "link:../dsh/packages/session/session-projection",
    "@deepseek-ai/dsh-token-meter": "link:../dsh/packages/token-meter/token-meter",
    "@deepseek-ai/dsh-session-stats": "link:../dsh/packages/session/session-stats",
    "@deepseek-ai/schemastery": "link:../dsh/vendor/schemastery",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
